# Valores locales de ejemplo. Todo funciona sin este archivo (son los valores por
# defecto de docker-compose.yml); copialo a .env solo si querés cambiar algo.

POSTGRES_USER=flota
POSTGRES_PASSWORD=flota_local

# Clave con la que n8n cifra sus credenciales guardadas. Solo para uso local.
N8N_ENCRYPTION_KEY=flota-ops-clave-local-no-usar-en-produccion
