    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO ops.turnos (vehiculo_id, motivo, fecha_hora, estado)\nVALUES ($1, $2, ($3 || ' ' || $4)::timestamp AT TIME ZONE 'America/Argentina/Buenos_Aires', 'CONFIRMADO')\nON CONFLICT (vehiculo_id, fecha_hora) DO NOTHING\nRETURNING id,\n  to_char(fecha_hora AT TIME ZONE 'America/Argentina/Buenos_Aires', 'DD/MM/YYYY HH24:MI') AS cuando,\n  extract(epoch FROM (fecha_hora - now()))::int AS segundos_hasta_turno",
        "options": {
          "queryReplacement": "={{ [ $('Buscar vehículo y cliente').first().json.vehiculo_id, $('Validar el pedido').first().json.motivo, $('Validar el pedido').first().json.fecha, $('Validar el pedido').first().json.hora ] }}"
        }
      },
