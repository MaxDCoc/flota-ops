    {
      "parameters": {
        "jsCode": "const t = $('Reservar el turno').first().json;\nconst v = $('Buscar vehículo y cliente').first().json;\nconst demo = v.demo_espera ? Number(v.demo_espera) : null;\nconst hastaRecordatorio = Math.max(Number(t.segundos_hasta_turno) - 24 * 3600, 0);\nreturn [{ json: { turno_id: t.id, cuando: t.cuando, espera: demo ?? hastaRecordatorio } }];"
      },
