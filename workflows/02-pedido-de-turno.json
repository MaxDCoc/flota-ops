        "subject": "=Turno confirmado para {{ $('Validar el pedido').first().json.patente }}: {{ $('Reservar el turno').first().json.cuando }}",
        "emailFormat": "html",
        "html": "=<p>Hola, confirmamos el turno de <b>{{ $('Validar el pedido').first().json.patente }}</b> para el <b>{{ $('Reservar el turno').first().json.cuando }}</b>.</p><p>Motivo: {{ $('Validar el pedido').first().json.motivo }}</p><p>Un día antes les mandamos un recordatorio.</p>",
        "options": {
