    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT v.id AS vehiculo_id, v.patente, c.nombre AS cliente, c.email_contacto,\n  (SELECT NULLIF(valor, '') FROM ops.config WHERE clave = 'demo_espera_segundos') AS demo_espera\nFROM ops.vehiculos v\nJOIN ops.clientes c ON c.id = v.cliente_id\nWHERE v.patente = $1 AND v.activo AND c.contrato_activo",
        "options": {
          "queryReplacement": "={{ [ $json.patente ] }}"
        }
      },
