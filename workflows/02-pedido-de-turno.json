{
  "name": "02 - Pedido de turno",
  "nodes": [
    {
      "parameters": {
        "content": "## Pedido de turno\n`POST /webhook/turno` con `patente`, `fecha`, `hora` y `motivo`.\nValida, consulta la agenda del taller por REST, reserva sin pisar horarios y manda confirmación. 24 h antes (o el tiempo de demo) envía el recordatorio si el turno sigue vigente.",
        "height": 170,
        "width": 620,
        "color": 4
      },
      "id": "48a577ed-377f-57a7-a3b0-93384f4e627c",
      "name": "Nota 0",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        200,
        20
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "turno",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "1b662272-2d60-52ab-bc3e-7e29a03d38c8",
      "name": "Pedido de turno",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        360
      ],
      "webhookId": "a46eaf10-a984-5417-b915-62657e9d74e2"
    },
    {
      "parameters": {
        "jsCode": "const b = $input.first().json.body ?? {};\nconst errores = [];\nconst patente = String(b.patente ?? '').toUpperCase().replace(/[\\s-]/g, '');\nif (!/^([A-Z]{2}\\d{3}[A-Z]{2}|[A-Z]{3}\\d{3})$/.test(patente)) errores.push('patente inválida (formato AA123BB)');\nconst fecha = String(b.fecha ?? '');\nconst hora = String(b.hora ?? '');\nconst motivo = String(b.motivo ?? '').trim();\nif (!/^\\d{4}-\\d{2}-\\d{2}$/.test(fecha) || isNaN(Date.parse(fecha))) {\n  errores.push('fecha inválida (AAAA-MM-DD)');\n} else {\n  const hoy = new Date().toLocaleDateString('en-CA', { timeZone: 'America/Argentina/Buenos_Aires' });\n  if (fecha < hoy) errores.push('la fecha ya pasó');\n}\nif (!/^\\d{2}:\\d{2}$/.test(hora)) errores.push('hora inválida (HH:MM)');\nif (motivo.length < 3) errores.push('indicá el motivo del turno');\nreturn [{ json: { ok: errores.length === 0, errores, patente, fecha, hora, motivo } }];"
      },
      "id": "c468ba6e-d240-542e-8ac3-5c23dc9b2f79",
      "name": "Validar el pedido",
