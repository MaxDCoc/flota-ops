{
  "name": "00 - Sincronizar odómetros",
  "nodes": [
    {
      "parameters": {
        "content": "## Odómetros\nCada hora trae el kilometraje desde la API del taller y actualiza `ops.vehiculos`.\nNunca baja un valor ya registrado.",
        "height": 150,
        "width": 460,
        "color": 4
      },
      "id": "2c0b6d91-8dcd-5241-a68c-7fd872f45ac2",
      "name": "Nota 0",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        200,
        40
      ]
    },
    {
      "parameters": {},
      "id": "a5cd3141-0d0f-5915-8868-3bda64c372a7",
      "name": "Ejecutar a mano",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        260,
        260
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 * * * *"
            }
          ]
        }
      },
      "id": "ab9fc067-a147-52ca-8ad6-50b96ed726dd",
      "name": "Cada hora",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        260,
        420
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://api:8000/vehiculos/odometros",
        "options": {
          "timeout": 30000
        }
      },
      "id": "ca8d0992-13f5-5cbe-bbfb-4e8eec43a395",
      "name": "Leer odómetros (API)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        540,
        340
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE ops.vehiculos\nSET km_actual = GREATEST(km_actual, $2)\nWHERE patente = $1\nRETURNING patente, km_actual",
        "options": {
          "queryReplacement": "={{ [ $json.patente, $json.km ] }}"
        }
      },
      "id": "71423b1d-5a14-5135-8a4a-e632efa69bcc",
      "name": "Actualizar kilometraje",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        820,
        340
      ],
      "credentials": {
        "postgres": {
          "id": "pgFlota0000001",
          "name": "Postgres flota"
        }
      }
    }
  ],
  "connections": {
    "Ejecutar a mano": {
      "main": [
        [
          {
            "node": "Leer odómetros (API)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Cada hora": {
      "main": [
        [
          {
            "node": "Leer odómetros (API)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Leer odómetros (API)": {
      "main": [
        [
          {
            "node": "Actualizar kilometraje",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "America/Argentina/Buenos_Aires",
    "errorWorkflow": "flota-99-errores"
  },
  "id": "flota-00-odometros"
}
